# Temporary bench profile: keep the USB PHY in Serial/JTAG device mode.
# CONFIG_STACKCHAN_DJI_MIC_USB_INPUT is not set
# CONFIG_STACKCHAN_DJI_MIC_DRIVE_VBUS is not set
# CONFIG_STACKCHAN_FIRMWARE_OTA_ENABLED is not set
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
